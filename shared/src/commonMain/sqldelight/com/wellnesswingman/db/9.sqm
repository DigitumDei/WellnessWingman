-- Migration from version 9 to version 10
-- Adds DailyCheckIn for subjective morning and evening check-ins.
-- These are stored outside the TrackedEntry stream on purpose: a Sleep entry suppresses
-- Polar's measured sleep data in DailySummaryService, and check-ins record feel, not measure.

CREATE TABLE DailyCheckIn (
    checkInId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    externalId TEXT,
    checkInDate INTEGER NOT NULL,
    slot TEXT NOT NULL,
    capturedAt INTEGER NOT NULL,
    responseText TEXT NOT NULL,
    inputSource TEXT NOT NULL,
    conversationExternalId TEXT
);

CREATE UNIQUE INDEX idx_daily_checkin_date_slot ON DailyCheckIn(checkInDate, slot);
