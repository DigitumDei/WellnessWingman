-- Migration from version 9 to version 10
-- Adds index on TrackedEntry.blobPath for idempotent photo entry lookup

-- Redeclare TrackedEntry with the relevant columns so SQLDelight's migration
-- validator can resolve the blobPath column. The CREATE TABLE IF NOT EXISTS
-- is a no-op at runtime (the table already exists from version 1).
CREATE TABLE IF NOT EXISTS TrackedEntry (
    entryId INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    blobPath TEXT
);

CREATE INDEX IF NOT EXISTS idx_tracked_entry_blob_path ON TrackedEntry(blobPath);